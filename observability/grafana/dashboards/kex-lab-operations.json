{
  "uid": "kex-lab-operations",
  "title": "Kex Lab \u2014 Integrated Operations",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "kex-lab",
    "kafka"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Metrics endpoint availability",
      "description": "1 means the metrics endpoint can be scraped; this does not prove every application capability or Kafka broker readiness.",
      "datasource": {
        "type": "prometheus",
        "uid": "kex-lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"kafka-explorer|kex-agent|autotune\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kex-lab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNAVAILABLE",
                  "color": "red"
                },
                "1": {
                  "text": "SCRAPING",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AutoTune consumer lag",
      "description": "Measured AutoTune consumer lag from its health endpoint. Not the lag of every Kafka group. Missing data stays unmeasured.",
      "datasource": {
        "type": "prometheus",
        "uid": "kex-lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kex_lab_autotune_consumer_lag{job=\"lab-metrics\"}",
          "legendFormat": "AutoTune lag",
          "datasource": {
            "type": "prometheus",
            "uid": "kex-lab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lag probe success",
      "description": "0 means lag could not be measured; a missing lag is never fabricated as zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "kex-lab-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kex_lab_autotune_probe_success{job=\"lab-metrics\"}",
          "legendFormat": "Probe",
          "datasource": {
            "type": "prometheus",
            "uid": "kex-lab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNAVAILABLE / NOT UP",
                  "color": "red"
                },
                "1": {
                  "text": "VERIFIED",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kafka traffic through AutoTune",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kex-lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(app_kafka_events_received_count_total{job=\"autotune\"}[$__rate_interval]))",
          "legendFormat": "Received",
          "datasource": {
            "type": "prometheus",
            "uid": "kex-lab-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(app_kafka_events_processed_total{job=\"autotune\",type=\"success\"}[$__rate_interval]))",
          "legendFormat": "Processed successfully",
          "datasource": {
            "type": "prometheus",
            "uid": "kex-lab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Consumer errors and retries",
      "description": "Counters may appear only after the first error/retry. No data means unmeasured; it is not replaced with zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "kex-lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(app_kafka_events_errors_total{job=\"autotune\"}[$__rate_interval]))",
          "legendFormat": "Errors",
          "datasource": {
            "type": "prometheus",
            "uid": "kex-lab-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(app_kafka_events_retried_total{job=\"autotune\"}[$__rate_interval]))",
          "legendFormat": "Retries",
          "datasource": {
            "type": "prometheus",
            "uid": "kex-lab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
