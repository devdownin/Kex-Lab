    {
      "id": 7,
      "type": "timeseries",
      "title": "Average batch duration",
      "description": "Undefined while there are no new batches; no zero-latency result is inferred.",
      "datasource": {
        "type": "prometheus",
        "uid": "kex-lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(app_kafka_events_batch_duration_seconds_sum{job=\"autotune\"}[$__rate_interval])) / sum(rate(app_kafka_events_batch_duration_seconds_count{job=\"autotune\"}[$__rate_interval]))",
          "legendFormat": "Batch duration",
          "datasource": {
            "type": "prometheus",
            "uid": "kex-lab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
